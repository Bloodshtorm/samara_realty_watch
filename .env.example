POSTGRES_DB=realty
POSTGRES_USER=realty
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://realty:change_me@postgres:5432/realty

BROWSER_PROFILE_DIR=/data/browser-profile
HEADLESS=true
TIMEZONE=Europe/Samara
COLLECT_INTERVAL_SECONDS=7200

SEARCHES_CONFIG_PATH=/app/config/searches.yaml
SCORING_CONFIG_PATH=/app/config/scoring.yaml

SCREENSHOTS_DIR=/app/data/debug/screenshots
HTML_DUMPS_DIR=/app/data/debug/html
LOG_LEVEL=INFO
