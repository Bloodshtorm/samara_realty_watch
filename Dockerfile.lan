FROM mcr.microsoft.com/playwright/python:v1.61.0-noble AS application
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 HOME=/home/pwuser
WORKDIR /app
COPY pyproject.toml alembic.ini ./
COPY app ./app
COPY collectors ./collectors
COPY services ./services
COPY migrations ./migrations
COPY scripts ./scripts
COPY tests ./tests
RUN pip install ".[dev]" && chmod +x /app/scripts/container-*.sh
USER 1000:1000
CMD ["uvicorn", "app.web:app", "--host", "0.0.0.0", "--port", "8000"]

FROM application AS browser
USER root
ARG CHROME_VERSION=152.0.7977.64-1
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg fluxbox novnc websockify x11vnc xvfb x11-utils \
    && curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
      | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
    && printf '%s\n' 'deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main' > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update && apt-get install -y --no-install-recommends "google-chrome-stable=${CHROME_VERSION}" \
    && rm -rf /var/lib/apt/lists/*
USER 1000:1000
CMD ["bash", "/app/scripts/container-browser.sh"]
